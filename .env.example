# PlayChale Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
# Server-only, on purpose: the browser always calls this app's own /api, which keeps the
# session cookie first-party and avoids a CORS preflight on every write.
# Leave empty to serve the built-in mock (mocks/api). Set it to the Go service's origin
# (e.g. http://localhost:8080 or https://api.playchale.app) to reverse-proxy to it instead.
API_ORIGIN=

# Simulated latency for mock API requests from the browser, in ms (default 150)
MOCK_API_LATENCY_MS=150

# Landing page hero: light (default) or cinematic. Preview either with /?hero=light or /?hero=cinematic
LANDING_HERO=light

# Authentication (for future use)
NEXT_PUBLIC_AUTH_URL=

# Google Maps (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

