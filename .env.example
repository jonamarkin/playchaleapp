# PlayChale Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
# Leave empty to use the built-in mock API (mocks/api), served at /api.
# Set to the real backend's base URL (e.g. https://api.playchale.app/v1) to use it instead.
NEXT_PUBLIC_API_URL=

# Simulated latency for mock API requests from the browser, in ms (default 150)
MOCK_API_LATENCY_MS=150

# Landing page hero: light (default) or cinematic. Preview either with /?hero=light or /?hero=cinematic
LANDING_HERO=light

# Authentication (for future use)
NEXT_PUBLIC_AUTH_URL=

# Google Maps (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

